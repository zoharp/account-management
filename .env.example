# ─────────────────────────────────────────────────────────────
# account-management — environment
#
# Every value here is SERVER-SIDE ONLY. Nothing is NEXT_PUBLIC_,
# and nothing in this file may ever be read from a client component.
#
# The first four MUST match the Orcanos QMS backend exactly, or
# sessions and encrypted secrets will not interoperate between the
# two apps. Copy them from the QMS backend's .env.
# ─────────────────────────────────────────────────────────────

# Master / platform Supabase — the DB holding accounts, users,
# auth_methods, account_usage_logs, security_audit_log.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Signs and verifies the HS256 session token. MUST be byte-identical to
# the QMS backend's JWT_SECRET — a token issued by either app is then
# accepted by both.
JWT_SECRET=

# base64-encoded 32 bytes, AES-256-GCM. MUST be identical to the QMS
# backend's ENCRYPTION_KEY or previously-saved account secrets cannot be
# decrypted. Generate a NEW one only for a fresh deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Provisioning (Supabase Management API) ────────────────────
# Personal Access Token: Supabase Dashboard > Account > Access Tokens
SUPABASE_ORG_ACCESS_TOKEN=sbp_...
SUPABASE_ORG_ID=
# Region for newly provisioned account projects
SUPABASE_PROJECT_REGION=us-east-1

# ── Platform gating ───────────────────────────────────────────
# Only users with an email in this domain AND role='admin' may use the app.
PLATFORM_EMAIL_DOMAIN=orcanos.com
# The account whose auth_methods row drives the login screen.
PLATFORM_ACCOUNT=orcanos

# ── Optional ──────────────────────────────────────────────────
# Absolute origin of this app, used to build the OAuth redirect_uri.
# Leave unset to derive it from the incoming request (correct on Vercel).
# APP_ORIGIN=https://account-management.vercel.app
