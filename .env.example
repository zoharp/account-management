# ─────────────────────────────────────────────────────────────
# account-management — environment
#
# Every value here is SERVER-SIDE ONLY. Nothing is NEXT_PUBLIC_,
# and nothing in this file may ever be read from a client component.
#
# The first four MUST match the Orcanos QMS backend exactly, or
# sessions and encrypted secrets will not interoperate between the
# two apps. Copy them from the QMS backend's .env.
# ─────────────────────────────────────────────────────────────

# Master / platform Supabase — the DB holding accounts, users,
# auth_methods, account_usage_logs, security_audit_log.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Signs and verifies the HS256 session token. MUST be byte-identical to
# the QMS backend's JWT_SECRET — a token issued by either app is then
# accepted by both.
JWT_SECRET=

# base64-encoded 32 bytes, AES-256-GCM. MUST be identical to the QMS
# backend's ENCRYPTION_KEY or previously-saved account secrets cannot be
# decrypted. Generate a NEW one only for a fresh deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Provisioning (Supabase Management API) ────────────────────
# Personal Access Token: Supabase Dashboard > Account > Access Tokens
SUPABASE_ORG_ACCESS_TOKEN=sbp_...
SUPABASE_ORG_ID=
# Region for newly provisioned account projects
SUPABASE_PROJECT_REGION=us-east-1

# ── Platform gating ───────────────────────────────────────────
# Only users with an email in this domain AND role='admin' may use the app.
PLATFORM_EMAIL_DOMAIN=orcanos.com
# The account whose auth_methods row drives the login screen.
PLATFORM_ACCOUNT=orcanos

# ── Orcanos sign-in ───────────────────────────────────────────
# What the login screen's "Orcanos URL" box is pre-filled with, and the
# fallback when neither the request nor the platform account's
# orcanos_api_url supplies one. Scheme and /api/v2/Json are added for you.
ORCANOS_LOGIN_URL=app.orcanos.com/orcanos
#
# Which hosts that box may point at. Defaults to orcanos.com, which matches
# itself and every subdomain (app., us., …), so leaving this unset is the
# correct production setting and every real tenant works. Comma-separated.
#
# ⚠️ The value `*` disables the restriction and is a pre-auth account takeover
# of this console — QW_Login's Is_admin then comes from a server the caller
# chose. Read SECURITY.md §9.2 before considering it. Clearing this variable
# does NOT disable the check; only `*` does.
# ORCANOS_LOGIN_HOST_ALLOWLIST=orcanos.com

# ── Optional ──────────────────────────────────────────────────
# Absolute origin of this app, used to build the OAuth redirect_uri.
# Leave unset to derive it from the incoming request (correct on Vercel).
# APP_ORIGIN=https://account-management.vercel.app

# ── Traceability matrix (module licences) ─────────────────────────────
# The traceability-matrix instance backing the Traceability and Training
# module licences, and its shared ADMIN_PASSWORD.
#   local dev : http://127.0.0.1:8010   (your uvicorn + its own SQLite)
#   Vercel    : https://traceability-matrix.fly.dev
# There is no direct-database mode - Vercel cannot reach either SQLite file.
TRACE_API_URL=http://127.0.0.1:8010
TRACE_ADMIN_PASSWORD=
